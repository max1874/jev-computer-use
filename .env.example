# The decision backend, when there is a tree to decide from.
#
# jev is a System One model: it answers a set of named questions, each with a
# choice and a probability distribution over the options. That is the shape
# this project's decision already had — one operation from a set, one index per
# operation — so nothing has to be asked to write JSON and nothing has to
# reconstruct probabilities from token logprobs. It takes text only, and it
# does not write text: TYPE_TEXT values come from TEXT_MODEL below, and a
# window with nothing in its tree falls through to the chat backend, which is
# the only one that can be shown a picture.
#
# Leave JEV_API_KEY unset to send every decision to the chat backend instead.
# JEV_API_KEY=apikey_...
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# The chat backend: any OpenAI-compatible endpoint. Used for every decision
# when JEV_API_KEY is unset, and for the screenshot fallback either way — so
# when both are configured this one should be a model that accepts images.
#
# Providers that constrain the answer server-side (OpenAI and compatible
# json_schema support) are used in strict mode. Providers that only guarantee
# valid JSON get the same shape spelled out in the prompt and validated here —
# an answer outside the offered choices is refused either way.
DECISION_API_KEY=
DECISION_BASE_URL=https://api.openai.com/v1
DECISION_MODEL=gpt-5.6

# DeepSeek V4.1-Flash: 1M context, cheap, returns logprobs, json_object only.
# DECISION_API_KEY=sk-...
# DECISION_BASE_URL=https://api.deepseek.com/v1
# DECISION_MODEL=deepseek-flash

# json_schema | json_object. Guessed from the base URL when unset.
# DECISION_RESPONSE_FORMAT=json_object

# Optional: a separate, smaller model for field values. Only needed when the
# decision backend chooses but cannot write text — a real System One model, for
# example. Falls back to the decision model when unset.
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# TEXT_MODEL=deepseek-flash

# The inspector binds to loopback only.
# OPEN_COMPUTER_USE_PORT=8767
